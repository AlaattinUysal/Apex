# Kopyala: .env.local  (.env.local asla commit edilmez)

# --- Supabase (Dashboard > Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — tarayıcıya açık, sorun değil
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SADECE sunucu, asla NEXT_PUBLIC_ yapma, asla paylaşma
SUPABASE_SECRET_KEY=

# --- AI servisi (Ertuğrul) ---
AI_SERVICE_URL=http://localhost:8000
# Next.js <-> AI servisi <-> n8n arasındaki ortak gizli anahtar (rastgele uzun bir değer)
INTERNAL_API_KEY=

# --- LiveKit (Dashboard > Settings > Project / API keys) ---
# WebSocket URL, ör. wss://proje-adi.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
# Secret yalnızca anahtar oluşturulurken bir kez gösterilir. SADECE sunucu, asla NEXT_PUBLIC_ yapma.
LIVEKIT_API_SECRET=

# Geliştirme: 1 ise AI servisi yerine sahte cevap döner
# AI_MOCK=1

# Test için: panel açıkken otomatik analiz aralığı (saniye, en az 10). Boşsa 300 (5 dk). 0 = otomatik analiz kapalı.
# NEXT_PUBLIC_AUTO_ANALYSIS_SECONDS=30

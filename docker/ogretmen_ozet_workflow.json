{
  "name": "Kullanıcı Mesajları Toplayıcı ve Öğretmen Özet Ajanı",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "yeni-mesaj",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        240
      ],
      "id": "webhook-mesaj-alici",
      "name": "Webhook (Kullanıcı Mesajı Geldi)"
    },
    {
      "parameters": {
        "operation": "append",
        "fileName": "/home/node/.n8n/bekleyen_mesajlar.json",
        "dataPropertyName": "={\"zaman\": \"{{ $now }}\", \"gonderen\": \"{{ $json.body.kullanici || 'Anonim' }}\", \"mesaj\": \"{{ $json.body.mesaj }}\"}\n"
      },
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        460,
        240
      ],
      "id": "dosyaya-kaydet",
      "name": "Mesajı Kuyruğa Kaydet"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"durum\": \"basarili\",\n  \"mesaj\": \"Mesajınız kaydedildi, 5 dakikalık periyotta özetlenecektir.\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        240
      ],
      "id": "webhook-yaniti",
      "name": "Kullanıcıya Yanıt Dön"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        480
      ],
      "id": "zamanlayici-5dk",
      "name": "Her 5 Dakikada Bir Çalış"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst filePath = '/home/node/.n8n/bekleyen_mesajlar.json';\n\nif (!fs.existsSync(filePath)) {\n  return [];\n}\n\nconst content = fs.readFileSync(filePath, 'utf8').trim();\nif (!content) {\n  return [];\n}\n\n// Satır satır JSON objelerini parse et\nconst lines = content.split('\\n').filter(Boolean);\nconst mesajlar = lines.map(line => {\n  try {\n    return JSON.parse(line);\n  } catch (e) {\n    return { mesaj: line };\n  }\n});\n\n// Okunduktan sonra dosyayı temizle (sıfırla)\nfs.writeFileSync(filePath, '');\n\nconst birlestirilmisMetin = mesajlar.map((m, idx) => `${idx + 1}. [${m.gonderen || 'Öğrenci'}]: ${m.mesaj}`).join('\\n');\n\nreturn [{\n  json: {\n    toplam_mesaj_sayisi: mesajlar.length,\n    birlestirilmis_mesajlar: birlestirilmisMetin\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        480
      ],
      "id": "mesajlari-topla-ve-temizle",
      "name": "Mesajları Oku ve Topla"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.toplam_mesaj_sayisi }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        480
      ],
      "id": "mesaj-var-mi-kontrol",
      "name": "Mesaj Var mı?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen bir eğitim asistanısın. Görevin, son 5 dakikada öğrencilerden gelen mesajları bir öğretmen için net, yapıcı ve profesyonel bir şekilde özetlemektir. KURALLAR: 1. Uygunsuz, argo, spam veya anlamsız mesajları tamamen görmezden gel ve özete dahil etme. 2. Öğrencilerin sorduğu soruları, takıldıkları noktaları ve ana konuları maddeler halinde özetle. 3. Öğretmenin hızlıca aksiyon alabileceği bir formatta sun.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"İşte son 5 dakikadaki öğrenci mesajları:\\n\\n{{ $json.birlestirilmis_mesajlar }}\"\n    }\n  ],\n  \"temperature\": 0.3\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        460
      ],
      "id": "yapay-zeka-ozet-istegi",
      "name": "Yapay Zeka Ajanı (Öğretmen Özeti)"
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $json.choices?.[0]?.message?.content || 'Özet üretilemedi.';\n\nreturn [{\n  json: {\n    durum: 'basarili',\n    tarih: new Date().toISOString(),\n    ozet: aiResponse\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        460
      ],
      "id": "ai-cevabini-isle",
      "name": "AI Yanıtını Formatla"
    }
  ],
